<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dontoribio.pos.controller.HistorialVentasController">

    <top>
        <VBox spacing="6.0" styleClass="panel-pesaje">
            <padding>
                <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
            </padding>
            <Label styleClass="etiqueta-seccion" text="Historial de ventas" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Desde:" />
                <DatePicker fx:id="datePickerDesde" />
                <Label text="Hasta:" />
                <DatePicker fx:id="datePickerHasta" />
                <Button text="Buscar" onAction="#onBuscarRango" defaultButton="true" />
                <Button text="Hoy" onAction="#onIrAHoy" />
            </HBox>
            <Label fx:id="labelResumen" text="0 venta(s) hoy - Total: S/ 0.00" />
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaVentas">
            <columns>
                <TableColumn fx:id="colFechaHora" text="Fecha y hora" prefWidth="140.0" />
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200.0" />
                <TableColumn fx:id="colTotal" text="Total" prefWidth="100.0" />
                <TableColumn fx:id="colMetodoPago" text="Metodo de pago" prefWidth="150.0" />
                <TableColumn fx:id="colComprobante" text="Comprobante" prefWidth="110.0" />
                <TableColumn fx:id="colVer" text="Boleta/Factura" prefWidth="110.0" sortable="false" />
            </columns>
        </TableView>
    </center>
</BorderPane>
