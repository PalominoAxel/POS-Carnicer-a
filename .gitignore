# Build output de Maven (se regenera con "mvn package"; no debe versionarse)
target/
dependency-reduced-pom.xml

# Configuracion privada de desarrollo.
# application.properties contiene solo opciones comunes sin credenciales.
src/main/resources/application-local.properties
# Copias de respaldo de configuracion (pueden contener claves)
*.bak

# IDEs y editores
.idea/
*.iml
.vscode/

# Configuracion local de herramientas de cada desarrollador (no son parte de la app)
.claude/
.agents/
skills-lock.json

# Logs generados en runtime (ver logback.xml) y respaldos locales de la base de datos
logs/
backups/

# Archivos del sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Variables privadas del equipo
.env
.env.*
src/main/resources/static/
*.env
# Scripts locales de despliegue
*.bat
# Registros de ejecución
logs/
# Configuración local privada
src/main/resources/application-local.properties
# Base de datos y datos locales
datos/
backups/
